# Điền cấu hình cục bộ trong .env khi triển khai các dịch vụ.
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
